# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
._*
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.lcov

# env files (can opt-in for committing if needed)
.env*

# uploads (local file storage) — everything here is generated at runtime:
# generated images, gallery/product index files, backups, brand configs.
/uploads/

# generated media anywhere else in the repo
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
*.bmp
*.tiff
*.mp4
*.webm

# ...except real app assets under public/ and src/.
# Scoped per-extension on purpose: a blanket `!/public/**` would also
# un-ignore .DS_Store, .env*, *.log etc. under those directories.
!/public/**/*.png
!/public/**/*.jpg
!/public/**/*.jpeg
!/public/**/*.webp
!/public/**/*.gif
!/public/**/*.avif
!/src/**/*.png
!/src/**/*.jpg
!/src/**/*.jpeg
!/src/**/*.webp
!/src/**/*.gif
!/src/**/*.avif

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs / editors
.vscode/
.idea/
*.swp
*~

# claude code working folders
/claude
.claude
